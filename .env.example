NODE_ENV=development
PORT=8787
SESSION_SECRET=dev-only-change-me
OTP_PROVIDER=mock
# Real SMS OTP (India): set FAST2SMS_API_KEY and OTP_PROVIDER=fast2sms
# FAST2SMS_API_KEY=
# In development, OTP_DEV_EXPOSE=true skips real SMS and shows "Tap to fill" on checkout.
OTP_DEV_EXPOSE=true
ADMIN_EMAIL=admin@habs.cafe
ADMIN_PASSWORD=habsos-admin
DB_PATH=./data/habsos.db
# SEED_DEMO=true  # opt-in only: demo members, bookings, and sample cafe orders

# Production SMS (Twilio-compatible). Used only when OTP_PROVIDER=sms.
# SMS_ACCOUNT_SID=
# SMS_AUTH_TOKEN=
# SMS_FROM=

# Online payments (Razorpay). When set, POS and guest order pages can collect UPI/card online.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# WhatsApp Cloud API. Never expose these to the browser. Leave blank until Meta credentials are ready.
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_WABA_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_GRAPH_VERSION=v21.0
